# 数据库配置（backend_core/database/db.py 从此文件读取）
# 复制本文件为 .env 并按需修改，.env 不要提交到版本库

# 日志是否写入文件：设为 true/yes/1 时各模块会写 .log 文件，不设或 false 则仅控制台（默认不写文件）
LOG_TO_FILE=false

# 方式一：分项配置
DB_HOST=192.168.31.237
DB_PORT=5446
DB_USER=postgres
DB_PASSWORD=qidianspacetime
DB_NAME=stock_analysis

# 方式二：直接写完整连接串（若设置则优先于上面分项）
# DATABASE_URL=postgresql+psycopg2://postgres:qidianspacetime@192.168.31.237:5446/stock_analysis

# 连接池与连接参数（可选）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600
DB_CONNECT_OPTIONS=-c deadlock_timeout=1s -c lock_timeout=5s -c statement_timeout=30s
# DB_ECHO=false


# ---------- backend_api/config.py ----------
# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API（可选）
# API_TITLE=股票分析系统API
# API_DESCRIPTION=股票分析系统的后端API服务
# API_VERSION=1.0.0

# CORS（可选，逗号分隔；不设则为 *）
# CORS_ORIGINS=*
# CORS_ALLOW_CREDENTIALS=true

# Gemini
GEMINI_API_KEY=

# SMTP（可选）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=股票分析系统

# 推送（可选）
# MAX_RETRY_COUNT=3
# PUSH_BATCH_SIZE=100
# REPORT_DIR=./reports
# PUSH_DEFAULT_TIMES=09:30,15:30

# 企业微信配置（必填，否则微信渠道不可用）
WECHAT_CORP_ID=ww375d78e2d17d6fef
WECHAT_AGENT_ID=1000002
WECHAT_CORP_SECRET=QuurSwIUtFgC5Cl3nBUl7I4XIXXkvL5jVRSAMjqCvSM


# ---------- backend_core 采集与定时任务 ----------
# Tushare（backend_core/config/config.py、main.py 使用的 DATA_COLLECTORS）
TUSHARE_TOKEN=9701deb356e76d8d9918d797aff060ce90bd1a24339866c02444014f
TUSHARE_MAX_RETRIES=3
TUSHARE_RETRY_DELAY=5
TUSHARE_TIMEOUT=30
TUSHARE_MAX_CONNECTION_ERRORS=10

# AKShare 采集器（可选）
AKSHARE_MAX_RETRIES=3
AKSHARE_RETRY_DELAY=5
AKSHARE_TIMEOUT=30
AKSHARE_SSL_VERIFY=false
AKSHARE_USE_FALLBACK_SOURCES=true

# 换手率采集补全天数（main.py）
COLLECTOR_TURNOVER_RATE_DAYS=30

# 定时任务 cron（main.py），不设则用代码内默认值。hour 可为 "11,15" 或 "9-11,13-16"，minute 为整数，dow=day_of_week 如 mon-fri
SCHED_AKSHARE_REALTIME_DOW=mon-fri
SCHED_AKSHARE_REALTIME_HOUR=15
SCHED_AKSHARE_REALTIME_MINUTE=15

SCHED_TUSHARE_HISTORICAL_HOUR=15
SCHED_TUSHARE_HISTORICAL_MINUTE=32

