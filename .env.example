# 数据库配置（backend_core/database/db.py 从此文件读取）
# 复制本文件为 .env 并按需修改，.env 不要提交到版本库

# 日志是否写入文件：设为 true/yes/1 时各模块会写 .log 文件，不设或 false 则仅控制台（默认不写文件）
LOG_TO_FILE=false

# 方式一：分项配置
DB_HOST=192.168.31.237
DB_PORT=5446
DB_USER=postgres
DB_PASSWORD=qidianspacetime
DB_NAME=stock_analysis

# 方式二：直接写完整连接串（若设置则优先于上面分项）
# DATABASE_URL=postgresql+psycopg2://postgres:qidianspacetime@192.168.31.237:5446/stock_analysis

# 连接池与连接参数（可选）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600
DB_CONNECT_OPTIONS=-c deadlock_timeout=1s -c lock_timeout=5s -c statement_timeout=30s
# DB_ECHO=false

# ---------- backend_api/config.py ----------
# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API（可选）
# API_TITLE=股票分析系统API
# API_DESCRIPTION=股票分析系统的后端API服务
# API_VERSION=1.0.0

# CORS（可选，逗号分隔；不设则为 *）
# CORS_ORIGINS=*
# CORS_ALLOW_CREDENTIALS=true

# GMS 选股 /api/screening/gms-strategy 线程池最大等待时间（秒），全 A 股约 6000+ 只时计算较久；默认 600。
# 生产若出现 502，多为 Nginx/网关 proxy_read_timeout 小于此值，需同步调大网关超时。
# GMS_SCREENING_TIMEOUT=600
# RPE 选股 /api/screening/rpe-strategy 超时（秒）；默认 600。与 Nginx proxy_read_timeout 对齐。
# RPE_SCREENING_TIMEOUT=600
# 选股页列表分页（可选）：use_pagination=true&page=1&page_size=50；默认 use_pagination=false 返回全量（兼容旧客户端）

# GMS 定时预计算（main.py）：将全 A / 全港股 / 自定义池 / 全量自关注(watchlist 全用户并集) 写入 gms_signal_trace，选股页「刷新」可先 trace_only 读库。
# ENABLE_GMS_PRECOMPUTE=true
# 自定义池代码，逗号/分号/空白分隔，如：000001,600519 或 00700 港股代码
# GMS_CUSTOM_STOCK_CODES=
# GMS 多版本预计算白名单（逗号分隔 config_id；留空则预计算所有 is_default 或 precompute_enabled 的版本）
# GMS_PRECOMPUTE_CONFIG_IDS=1,2
# 各任务 cron（day_of_week / hour / minute），默认错开采集高峰
# SCHED_GMS_SIGNALS_CN_DOW=mon-fri
# SCHED_GMS_SIGNALS_CN_HOUR=18
# SCHED_GMS_SIGNALS_CN_MINUTE=20
# SCHED_GMS_SIGNALS_HK_DOW=mon-fri
# SCHED_GMS_SIGNALS_HK_HOUR=18
# SCHED_GMS_SIGNALS_HK_MINUTE=50
# SCHED_GMS_SIGNALS_CUSTOM_DOW=mon-fri
# SCHED_GMS_SIGNALS_CUSTOM_HOUR=19
# SCHED_GMS_SIGNALS_CUSTOM_MINUTE=10
# SCHED_GMS_SIGNALS_WATCHLIST_DOW=mon-fri
# SCHED_GMS_SIGNALS_WATCHLIST_HOUR=19
# SCHED_GMS_SIGNALS_WATCHLIST_MINUTE=25

# URT 上升趋势策略定时预计算（main.py → urt_signal_trace）：A 股 / 港股全市场扫描
# 建议：A 股预计算早于 urt_daily 推送；推送宜单点（如 17:30），勿早于预计算完成
# ENABLE_URT_PRECOMPUTE=true
# URT_PRECOMPUTE_CONFIG_IDS=1,2
# SCHED_URT_SIGNALS_CN_DOW=mon-fri
# SCHED_URT_SIGNALS_CN_HOUR=16
# SCHED_URT_SIGNALS_CN_MINUTE=45
# SCHED_URT_SIGNALS_HK_DOW=mon-fri
# SCHED_URT_SIGNALS_HK_HOUR=17
# SCHED_URT_SIGNALS_HK_MINUTE=20

# RPE 比价效应日终预计算（main.py → rpe_signals_cn）：写入 rpe_signal_trace，选股可 trace_only 读库。
# 设计说明见 docs/RPE_STRATEGY_IMPLEMENTATION_DESIGN.md
# ENABLE_RPE_PRECOMPUTE=true
# SCHED_RPE_SIGNALS_CN_DOW=mon-fri
# SCHED_RPE_SIGNALS_CN_HOUR=19
# SCHED_RPE_SIGNALS_CN_MINUTE=40

# 环境数据同步（本地↔生产）：生产维护 ENV_SYNC_KEY 或管理端 server-config；
# 本地管理端配置生产 Base URL + Key（表 env_sync_client_config），也可 env 回退：
# ENV_SYNC_KEY=
# ENV_SYNC_PROD_BASE_URL=https://www.icemaplecity.com
# 行情同步单次最大天数（默认 366）：
# ENV_SYNC_QUOTE_MAX_DAYS=366

# Gemini
GEMINI_API_KEY=

# 同花顺 Fuyao REST（个股详情实时行情优先源）
# 也可不配：自动读取 %APPDATA%\hithink-finance\credentials.env 中的 HITHINK_FINANCE_API_KEY
# HITHINK_FINANCE_API_KEY=
# FUYAO_API_KEY=
# FUYAO_BASE_URL=https://fuyao.aicubes.cn

# SMTP（可选）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=股票分析系统

# 推送（可选）
# MAX_RETRY_COUNT=3
# PUSH_BATCH_SIZE=100
# REPORT_DIR=./reports
# PUSH_DEFAULT_TIMES=09:30,15:30

# 微信（可选）
# WECHAT_CORP_ID=
# WECHAT_CORP_SECRET=
# WECHAT_AGENT_ID=
# 可选：第二企业主体（推送任务 user_push_configs.wechat_app_profile=B 时使用）
# WECHAT_B_CORP_ID=
# WECHAT_B_CORP_SECRET=
# WECHAT_B_AGENT_ID=
# WECHAT_SECRET=
# WECHAT_TOKEN=
# WECHAT_ENCODING_AES_KEY=

# ---------- backend_core 采集与定时任务 ----------
# Tushare（backend_core/config/config.py、main.py 使用的 DATA_COLLECTORS）
TUSHARE_TOKEN=
# CAN SLIM：财务采集 auto=Tushare 优先；指数日线 auto=AkShare 优先（均可设 tushare|akshare）
# CANSLIM_FINA_SOURCE=auto
# CANSLIM_INDEX_SOURCE=auto
# CANSLIM_FINA_MAX_STOCKS=
# CANSLIM_FINA_YEARS_BACK=4
# CANSLIM_INDEX_YEARS_BACK=3
# AkShare 财务：单次超时秒 / 票间隔 / 进度日志间隔
# CANSLIM_AK_FINA_TIMEOUT=25
# CANSLIM_AK_FINA_SLEEP=0.25
# CANSLIM_AK_FINA_LOG_EVERY=10
# TUSHARE_MAX_RETRIES=3
# TUSHARE_RETRY_DELAY=5
# TUSHARE_TIMEOUT=30
# TUSHARE_MAX_CONNECTION_ERRORS=10

# AKShare 采集器（可选）
# AKSHARE_MAX_RETRIES=3
# AKSHARE_RETRY_DELAY=5
# AKSHARE_TIMEOUT=30
# AKSHARE_SSL_VERIFY=false
# AKSHARE_USE_FALLBACK_SOURCES=true

# manual_scripts/update_stock_basic_info_em.py：东方财富个股资料补丁
# 增量模式下「多久未同步算过期」（天），默认 7
# STOCK_EM_PROFILE_STALE_DAYS=7
# 每只股票请求后的休眠秒数（避免打爆源站），默认 5
# STOCK_EM_API_INTERVAL_SEC=5

# 换手率采集补全天数（main.py）
# COLLECTOR_TURNOVER_RATE_DAYS=30

# 全市场 MA/MAVOL 批量计算调优（batch_ma_mavol.py，A 股/港股历史采集后指标）
# MA_MAVOL_LOOKBACK_DAYS=320
# MA_MAVOL_BATCH_SIZE=500
# MA_MAVOL_UPSERT_BATCH_SIZE=1000
# MA_MAVOL_COMPUTE_WORKERS=0

# 全市场 PVFRS（GMS 上游指标）批量计算（batch_mean_frequency.py）
# PVFRS_LOOKBACK_DAYS=90
# PVFRS_BATCH_SIZE=500
# PVFRS_UPSERT_BATCH_SIZE=1000

# GMS 预计算调优
# GMS_BARS_BATCH_SIZE=500
# GMS_TRACE_UPSERT_BATCH_SIZE=500
# GMS_PRECOMPUTE_CONFIG_IDS=1
# AKShare 历史换手率定时补采：默认关闭；设为 true 才注册 cron 并执行
# SCHED_AKSHARE_TURNOVER_ENABLED=true

# 定时任务 cron（main.py），不设则用代码内默认值。hour 可为 "11,15" 或 "9-11,13-16"，minute 为整数，dow=day_of_week 如 mon-fri
# SCHED_AKSHARE_REALTIME_DOW=mon-fri
# SCHED_AKSHARE_REALTIME_HOUR=15
# SCHED_AKSHARE_REALTIME_MINUTE=31
# AKSHARE_REALTIME_BATCH_SIZE=500
# SCHED_TUSHARE_HISTORICAL_HOUR=16
# SCHED_TUSHARE_HISTORICAL_MINUTE=2
# SCHED_AKSHARE_INDEX_REALTIME_HOUR=11,15
# SCHED_AKSHARE_INDEX_REALTIME_MINUTE=59
# SCHED_AKSHARE_INDUSTRY_HOUR=11,16
# SCHED_AKSHARE_INDUSTRY_MINUTE=3
# 行业板块成分股同步（每月一次，stock_board_industry_cons_em）
# SCHED_INDUSTRY_CONS_DAY=1
# SCHED_INDUSTRY_CONS_HOUR=16
# SCHED_INDUSTRY_CONS_MINUTE=30
# INDUSTRY_CONS_API_INTERVAL_SEC=0.3
# INDUSTRY_CONS_MAX_RETRIES=2
# SCHED_AKSHARE_TURNOVER_HOUR=11
# SCHED_AKSHARE_TURNOVER_MINUTE=13
# 股本同步（stock_shares_update）调度模式：
# - weekly：按周执行（默认）
# - monthly：按月执行（每月第 N 天）
# - quarterly：按季度执行（默认 1/4/7/10 月）
# SCHED_STOCK_SHARES_MODE=weekly
# SCHED_STOCK_SHARES_DOW=sat
# SCHED_STOCK_SHARES_DAY=1
# SCHED_STOCK_SHARES_QUARTER_MONTHS=1,4,7,10
# SCHED_STOCK_SHARES_HOUR=10
# SCHED_STOCK_SHARES_MINUTE=0
# 股本数据源：auto（默认，Tushare daily_basic 批量优先，失败再东财/巨潮）|
# tushare | akshare（东财→巨潮逐票）| cninfo | excel
# STOCK_SHARES_SOURCE=auto
# STOCK_SHARES_UPDATE_SOURCE=auto
# STOCK_SHARES_MODE=incremental
# STOCK_SHARES_TRADE_DATE=  # 可选 YYYYMMDD，指定 Tushare daily_basic 交易日
# STOCK_SHARES_EXCEL_PATH=
# STOCK_SHARES_EXCEL_SHEET=0
# SCHED_HK_REALTIME_HOUR=16
# SCHED_HK_REALTIME_MINUTE=39
# SCHED_HK_HISTORICAL_HOUR=16
# SCHED_HK_HISTORICAL_MINUTE=55
# SCHED_WEEKLY_HOUR=16
# SCHED_WEEKLY_MINUTE=25
# SCHED_HK_WEEKLY_HOUR=17
# SCHED_HK_WEEKLY_MINUTE=1
# SCHED_MONTHLY_HOUR=16
# SCHED_MONTHLY_MINUTE=30
# SCHED_HK_MONTHLY_HOUR=17
# SCHED_HK_MONTHLY_MINUTE=5
# 季线/半年线/年线生成开关（A股+港股共用；false 则不注册对应定时任务）
# 为 true 时任务仍按日 cron 触发，但仅在季末/半年末/年末最后一个交易日真正生成
# ENABLE_QUARTERLY_COLLECTION=true
# ENABLE_SEMIANNUAL_COLLECTION=true
# ENABLE_ANNUAL_COLLECTION=true
# ETF 总开关（默认 true=保持现有行为）：false 时不注册/不执行 ETF 定时采集，管理端 ETF 采集拒绝，选股页隐藏「全部ETF」
# ENABLE_ETF=true
# SCHED_ETF_REALTIME_DOW=mon-fri
# SCHED_ETF_REALTIME_HOUR=15
# SCHED_ETF_REALTIME_MINUTE=33
# SCHED_ETF_HISTORICAL_DOW=mon-fri
# SCHED_ETF_HISTORICAL_HOUR=16
# SCHED_ETF_HISTORICAL_MINUTE=5
# SCHED_QUARTERLY_HOUR=16
# SCHED_QUARTERLY_MINUTE=35
# SCHED_HK_QUARTERLY_HOUR=17
# SCHED_HK_QUARTERLY_MINUTE=9
# SCHED_SEMIANNUAL_HOUR=16
# SCHED_SEMIANNUAL_MINUTE=42
# SCHED_HK_SEMIANNUAL_HOUR=17
# SCHED_HK_SEMIANNUAL_MINUTE=13
# SCHED_ANNUAL_HOUR=16
# SCHED_ANNUAL_MINUTE=47
# SCHED_HK_ANNUAL_HOUR=17
# SCHED_HK_ANNUAL_MINUTE=16
# SCHED_HK_INDEX_REALTIME_HOUR=12,16
# SCHED_HK_INDEX_REALTIME_MINUTE=35
# SCHED_HK_INDEX_HISTORICAL_HOUR=17
# SCHED_HK_INDEX_HISTORICAL_MINUTE=18
