# Windows CVM 生产环境变量模板
ENVIRONMENT=production
BACKEND_PORT=5000
UVICORN_WORKERS=2

# PostgreSQL
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/stock_analysis

# Redis（如启用）
REDIS_URL=redis://127.0.0.1:6379/0

# 邮件/推送（按需）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# 调度器
ENABLE_WEEKEND_PUSH=false
PUSH_CONFIG_REFRESH_INTERVAL_MINUTES=5
