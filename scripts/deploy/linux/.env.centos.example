# CentOS 生产环境变量模板
# 复制到 /opt/stock_quote/shared/.env 后填写真实值。
# systemd EnvironmentFile 要求：每行 KEY=VALUE，不要 export，值中少用未转义空格。

ENVIRONMENT=production
BACKEND_PORT=5000
UVICORN_WORKERS=2
FRONTEND_PORT=8000
ADMIN_PORT=8001

# PostgreSQL（推荐完整 URL；也可用分项 DB_*）
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@127.0.0.1:5432/stock_analysis
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=CHANGE_ME
# DB_NAME=stock_analysis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# JWT（迁机后若需保持已登录会话，可与旧机相同；否则换强随机）
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 日志：生产建议按需打开文件日志（写到项目 logs/，见 logging_utils）
LOG_TO_FILE=false

# GMS 选股超时（须 ≤ Nginx proxy_read_timeout，centos 配置为 600s）
GMS_SCREENING_TIMEOUT=600

# 采集
TUSHARE_TOKEN=

# 邮件
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=股票分析系统

# 企业微信推送（与 backend_api/services/push_service.py 一致）
# 默认档：
WECHAT_CORP_ID=
WECHAT_CORP_SECRET=
WECHAT_AGENT_ID=
# 命名 profile 示例（用户配置里填 profile=B 时）：
# WECHAT_B_CORP_ID=
# WECHAT_B_CORP_SECRET=
# WECHAT_B_AGENT_ID=

# 推送调度
ENABLE_WEEKEND_PUSH=false
PUSH_CONFIG_REFRESH_INTERVAL_MINUTES=5
MAX_RETRY_COUNT=3
PUSH_BATCH_SIZE=100
REPORT_DIR=/opt/stock_quote/shared/reports

# Redis（若业务启用）
# REDIS_URL=redis://127.0.0.1:6379/0
